# PostgreSQL 連線字串（請勿將實際帳密提交到 Git）。
# 系統會自動使用 role_web schema，不需在此網址加入 search_path。
DATABASE_URL=postgresql://policy_app:change-me@localhost:5432/policy_center

# 可選：覆寫 PostgreSQL schema 搜尋路徑。正式環境請維持 role_web 在最前面。
PGOPTIONS=-c search_path=role_web,public

# Express API 監聽埠
PORT=3001

# 前端可呼叫 API 的來源；可用逗號分隔多個網址。
# Vite 開發伺服器預設為 http://localhost:5173。
CORS_ORIGIN=http://localhost:5173

# 登入提供者：demo 為本機四個測試帳號；接公司 API 時改為 company_api。
AUTH_PROVIDER=demo

# 測試帳號密碼（可自行改為更安全的值；員編仍為 A0001 ~ A0004）
DEMO_ADMIN_PASSWORD=admin123
DEMO_EMPLOYEE_PASSWORD=employee123
DEMO_DEPARTMENT_HEAD_PASSWORD=department123
DEMO_SITE_HEAD_PASSWORD=site123
