{
  "name": "policy-center",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.3.0"
  },
  "scripts": {
    "dev": "cd frontend && ../node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "cd frontend && ../node_modules/vite/bin/vite.js build",
    "start": "cd frontend && ../node_modules/vite/bin/vite.js preview --host 0.0.0.0",
    "api:dev": "cd backend && node --watch server/index.js",
    "api:start": "cd backend && node server/index.js",
    "lint": "eslint --config frontend/eslint.config.mjs frontend backend --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.39.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "5.4.19"
  },
  "type": "module"
}
