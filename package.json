{
  "name": "policy-center",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cd frontend && ../node_modules/vinext/dist/cli.js dev",
    "build": "cd frontend && ../node_modules/vinext/dist/cli.js build",
    "start": "cd frontend && ../node_modules/vinext/dist/cli.js start",
    "api:dev": "cd backend && node --watch server/index.js",
    "api:start": "cd backend && node server/index.js",
    "lint": "eslint --config frontend/eslint.config.mjs frontend backend --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "next": "16.2.6",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13"
  },
  "type": "module"
}
